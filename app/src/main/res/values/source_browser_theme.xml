<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="source_browser_background">#FFFBFE</color>
    <color name="source_browser_foreground">#1D1B20</color>
    <color name="source_browser_accent">#6750A4</color>
    <style name="Theme.SourceBrowser.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="colorControlNormal">@color/source_browser_foreground</item>
        <item name="android:colorBackground">@color/source_browser_background</item>
        <item name="android:statusBarColor">@color/source_browser_background</item>
        <!-- API 24-26 only support light navigation icons. -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.SourceBrowser" parent="Theme.SourceBrowser.Base" />
</resources>
