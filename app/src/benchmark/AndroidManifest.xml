<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="indi.renakoni.nextvol.benchmark.BenchmarkFixtureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="indi.renakoni.nextvol.benchmark.SEED" />
                <action android:name="indi.renakoni.nextvol.benchmark.SEED_SOURCE" />
                <action android:name="indi.renakoni.nextvol.benchmark.STARTUP_FIXTURE" />
                <action android:name="indi.renakoni.nextvol.benchmark.SPEECH_ENGINE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".benchmark.StartupBrowserProbeReceiver"
            android:exported="true" android:process=":source_browser" />
        <receiver android:name=".benchmark.StartupNativeBrowserProbeReceiver"
            android:exported="true" android:process=":source_browser_native" />
        <service android:name=".benchmark.StartupIsolatedProbeService"
            android:exported="false" android:isolatedProcess="true"
            android:process=":startup_probe_isolated" />
    </application>
</manifest>
