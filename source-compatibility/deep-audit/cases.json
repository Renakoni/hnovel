  {
    "name": "replace_lines",
    "source": {
      "bookSourceUrl": "ROOT/deep/replace_lines/source",
      "bookSourceName": "Deep audit replace_lines",
      "bookSourceType": 0,
      "searchUrl": "/deep/replace_lines/search",
      "ruleSearch": {
        "bookList": "li",
        "name": "a@text",
        "bookUrl": "a@href"
      },
      "ruleBookInfo": {
        "name": "h1@text",
        "tocUrl": "a.toc@href",
        "lastChapter": "@js:\"Updated\""
      },
      "ruleToc": {
        "chapterList": "li",
        "chapterName": "a@text",
        "chapterUrl": "a@href"
      },
      "ruleContent": {
        "content": "article@html",
        "replaceRegex": "##(?m)^DROP[^\\n]*$##"
      }
    },
    "pages": {
      "/deep/replace_lines/search": {
        "body": "<li><a href=\"/deep/replace_lines/book\">Fixture</a></li>"
      },
      "/deep/replace_lines/book": {
        "body": "<h1>Fixture</h1><a class=\"toc\" href=\"/deep/replace_lines/toc\">TOC</a>"
      },
      "/deep/replace_lines/toc": {
        "body": "<li><a href=\"/deep/replace_lines/chapter\">One</a></li><li><a href=\"/deep/replace_lines/next-chapter\">Two</a></li>"
      },
      "/deep/replace_lines/chapter": {
        "body": "<article><p>KEEP first</p><p>DROP advertisement</p><p>KEEP last</p></article>"
      }
    }
  },
